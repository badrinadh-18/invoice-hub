# ==========================================
# InvoiceHub — Environment Configuration
# ==========================================

# Server Configuration
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/invoicehub
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/invoicehub_test
CORS_ORIGIN=http://localhost:5173

# Authentication Secrets
JWT_SECRET=your_strong_jwt_secret_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# Initial Administrator Provisioning (used during `npm run seed`)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@invoicehub.local
ADMIN_PASSWORD=Admin@InvoiceHub2026

# Client Configuration
VITE_API_URL=http://localhost:5001/api/v1
